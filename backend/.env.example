PORT=5000
NODE_ENV=development

# Allowed frontend origin(s), comma-separated (set to your Vercel URL in production)
FRONTEND_ORIGIN=http://localhost:5173

# Air quality data (optional; falls back to Open-Meteo if omitted/unavailable)
WAQI_TOKEN=replace_with_your_waqi_token

# AI Provider: "groq" (recommended for cloud) or "ollama" (local development)
AI_PROVIDER=ollama

# Cloud AI (Groq free tier - OpenAI-compatible; required for cloud deployment)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=replace_with_your_groq_api_key

# Local AI (Ollama - development only; not available on cloud hosts)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
